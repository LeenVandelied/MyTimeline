# =============================================================
# MyTimeline — variables d'environnement pour docker compose (#37)
# Copier vers `.env` (ignoré par git) et ajuster si besoin.
# `docker compose up` fonctionne SANS .env (defaults dev intégrés au compose),
# mais un .env explicite est recommandé pour changer les secrets.
# AUCUN secret réel ici : uniquement des placeholders de dev.
# =============================================================

# --- Profil Spring actif ---
# dev (défaut) : onboarding local. NE PAS mettre `prod` sans fournir aussi
# CORS_ALLOWED_ORIGINS, une JWT_PRIVATE_KEY, un EXPORT_TOKEN_SECRET et un DB_PASSWORD dédiés.
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL / Datasource ---
# POSTGRES_USER / POSTGRES_PASSWORD (conteneur postgres) sont alignés sur
# DB_USERNAME / DB_PASSWORD (lus par le backend). Garder les deux cohérents.
DB_USERNAME=eventuser
DB_PASSWORD=motdepasse_dev_local
# Nom de la base créée au 1er démarrage du conteneur postgres.
POSTGRES_DB=eventmanager

# --- Sécurité JWT (#323 — signature ASYMÉTRIQUE RS256) ---
# JWT_SECRET (HS256) A ÉTÉ SUPPRIMÉ. Ne pas le réintroduire : il servait à la fois à
# émettre ET à vérifier, ce qui interdisait toute vérification hors du backend.
#
# Clé PRIVÉE de signature, format PKCS#8 en Base64 (armure PEM tolérée). Générer :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkcs8 -topk8 -nocrypt -in jwt.pem -outform DER | base64 | tr -d '\n'
# ⚠ Le `tr -d '\n'` n'est PAS cosmétique : le `base64` de GNU coreutils (donc toute image
# Linux, dont celles de ce docker-compose) replie sa sortie à 76 colonnes. Un fichier .env
# ne supporte pas les valeurs multi-lignes — seule la 1re ligne serait lue, et la clé serait
# tronquée. (Le base64 de macOS/BSD ne replie pas : le bug ne se voit pas en local.)
# La clé publique en est DÉRIVÉE côté backend : rien d'autre à configurer ici.
# VIDE (défaut) = paire ÉPHÉMÈRE générée à chaque démarrage du backend : pratique en
# local, mais toute session est perdue au redémarrage. AUCUNE clé n'est fournie en dur
# dans ce dépôt PUBLIC. En prod, le boot ÉCHOUE si la valeur est vide (ProfileSafetyGuard).
JWT_PRIVATE_KEY=

# --- Tokens de téléchargement d'export RGPD (#58 / #323) ---
# Secret HMAC DÉDIÉ (ne partage plus la clé d'auth : compromettre l'un ne compromet
# plus l'autre). Valeur ci-dessous = dev INSÉCURISÉE, à régénérer.
# Base64 STANDARD décodant à >= 32 octets. En prod : `openssl rand -base64 48`.
EXPORT_TOKEN_SECRET=ZGV2LW9ubHktaW5zZWN1cmUtZXhwb3J0LXRva2VuLXNlY3JldC1jaGFuZ2UtbWUhIQ==

# --- Email Brevo / mot de passe oublié (#49) ---
# Clé API Brevo, lue par le backend (BrevoEmailService, POST api.brevo.com/v3/smtp/email).
# OBLIGATOIRE en prod pour que les emails de réinitialisation partent réellement.
# VIDE (défaut dev/test) = BrevoEmailService passe en NO-OP SILENCIEUX (juste un
# warning en log) : le flux « mot de passe oublié » répond quand même 200 (token
# créé en base, BR-AUT-005 anti-énumération préservée), mais AUCUN email ne part.
# JAMAIS committer la vraie valeur.
# ⚠ `docker-compose.yml` ne propage PAS encore cette variable au service backend :
# la renseigner ici seul ne suffit pas à l'activer sous `docker compose up` (#376).
BREVO_API_KEY=xkeysib-REMPLACER-PAR-VOTRE-CLE
# Expéditeur affiché dans l'email (defaults backend si vide : no-reply@mytimeline.app / MyTimeline)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# --- Frontend (variable PUBLIQUE, bakée au build de l'image frontend) ---
# Le NAVIGATEUR (hôte) appelle le backend : l'URL doit être joignable depuis
# l'hôte, donc localhost:8080 (le port backend publié), PAS le nom de service.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --- Frontend : origine canonique des redirections du middleware (#322) ---
# Lue au RUNTIME par `frontend/middleware.ts` (variable NON publique : pas de
# rebuild d'image nécessaire pour la changer, et rien n'part au navigateur).
# Domaine(s) publics du site, séparés par des virgules. Le PREMIER est le
# canonique : une requête arrivant sur un hôte non listé est redirigée vers lui.
# Formes acceptées : `app.example.com`, `app.example.com:8443`,
# `https://app.example.com` (la forme avec schéma impose aussi le protocole).
#   Ex. prod    : APP_CANONICAL_HOST=https://mytimeline.example
#   Ex. preview : APP_CANONICAL_HOST=https://mytimeline.example,https://preview.mytimeline.example
# VIDE (défaut) = DÉGRADÉ ASSUMÉ : aucune réécriture, comportement d'avant #322.
# Il n'existe AUCUN garde-fou qui refuse le boot si la variable manque en prod
# (pas d'équivalent frontend au `ProfileSafetyGuard` backend) — cf. ADR-004.
APP_CANONICAL_HOST=

# --- Frontend : clé PUBLIQUE de vérification de signature du cookie jwt (#323) ---
# Lue au RUNTIME par `frontend/middleware.ts` (variable NON publique). Format SPKI
# Base64 (armure PEM tolérée). Ce n'est PAS un secret — mais elle DOIT correspondre à
# JWT_PRIVATE_KEY, sinon tout utilisateur connecté est renvoyé vers /login. Obtenir :
#   openssl rsa -in jwt.pem -pubout -outform DER | base64 | tr -d '\n'
# En dev (paire éphémère), la valeur est journalisée au démarrage du backend.
# VIDE (défaut) = DÉGRADÉ ASSUMÉ : la garde retombe sur la seule présence du cookie
# (comportement d'avant #323). Aucun garde-fou frontend ne refuse le boot — cf. ADR-004.
AUTH_JWT_PUBLIC_KEY=
