.DS_Store

# Ignorer les fichiers environnementaux
.env
.env.local
.env.production
.env.development

# Ignorer les dépendances spécifiques à Java/Spring Boot
*.log
*.class

# === BACKEND (Spring Boot) ===
backend/target/
# Maven wrapper TRACKÉ (cd backend && ./mvnw) — type only-script, pas de jar.
# On garde le wrapper versionné mais on ignore les éventuels artefacts .mvn locaux.
backend/.mvn/*
!backend/.mvn/wrapper/
backend/.idea/
backend/*.iml
backend/*.iws
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/build/
backend/.sts4-cache
backend/.springBeans

# === BACKEND : Fichiers sensibles (Spring Boot) ===
backend/.env
backend/.env.local
backend/.env.production
backend/.env.development
# application.properties + profils dev/prod restent TRACKÉS mais SANS secret en clair
# (valeurs via ${VAR} / variables d'environnement). Cf. issue #34.
# On ignore uniquement les overrides LOCAUX susceptibles de contenir des secrets :
backend/src/main/resources/application-local.properties
backend/src/main/resources/application.yml
backend/src/main/resources/application.yaml
backend/application.properties
backend/application.yml
backend/application.yaml
backend/logs/

# === FRONTEND (Next.js / React) ===
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.idea/
frontend/.vscode/
frontend/dist/
frontend/*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# === FRONTEND : Fichiers sensibles ===
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development


# === GEENERAL : Fichiers sensibles ===
node_modules/

# === Outillage local Claude Code (métriques tokens, worktrees, cache — non projet) ===
.claude/

# === Config MCP locale (contient des clés API — ne jamais committer) ===
.mcp.json

# === State local du plugin ai-env (régénérable, non projet) ===
frontend/.ai-env/