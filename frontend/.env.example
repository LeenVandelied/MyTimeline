# =============================================================
# EXEMPLE de configuration frontend (Next.js).
# Copier vers .env.local et renseigner les valeurs. NE PAS committer .env.local.
# Les variables NEXT_PUBLIC_* sont exposees au navigateur : aucun secret ici.
# =============================================================

# URL de base de l'API backend (ex : http://localhost:8080)
NEXT_PUBLIC_API_URL=

# Origine canonique des redirections emises par middleware.ts (#322).
# NON publique : lue au runtime serveur, jamais envoyee au navigateur.
# Liste separee par des virgules, la PREMIERE entree est le canonique.
# Ex : https://mytimeline.example  /  localhost:3000  /  app.example.com:8443
# VIDE = degrade assume (aucune reecriture). Cf. docs/adr/ADR-004.
APP_CANONICAL_HOST=
