# =============================================================
# EXEMPLE de configuration frontend (Next.js).
# Copier vers .env.local et renseigner les valeurs. NE PAS committer .env.local.
# Les variables NEXT_PUBLIC_* sont exposees au navigateur : aucun secret ici.
# =============================================================

# URL de base de l'API backend (ex : http://localhost:8080)
NEXT_PUBLIC_API_URL=

# Origine canonique des redirections emises par middleware.ts (#322).
# NON publique : lue au runtime serveur, jamais envoyee au navigateur.
# Liste separee par des virgules, la PREMIERE entree est le canonique.
# Ex : https://mytimeline.example  /  localhost:3000  /  app.example.com:8443
# VIDE = degrade assume (aucune reecriture). Cf. docs/adr/ADR-004.
APP_CANONICAL_HOST=

# Cle PUBLIQUE de verification de signature du cookie `jwt` (#323).
# NON publique au sens Next (lue au runtime serveur, jamais envoyee au navigateur), mais
# ce n'est PAS un secret : seule la cle PRIVEE (JWT_PRIVATE_KEY, cote backend) signe.
# Format SPKI Base64, armure PEM toleree. Elle DOIT correspondre a JWT_PRIVATE_KEY, sinon
# tout utilisateur connecte est renvoye vers /login. Obtenir :
#   openssl rsa -in jwt.pem -pubout -outform DER | base64 | tr -d '\n'
# (le `tr -d` est obligatoire : le base64 GNU replie a 76 colonnes, un .env ne lit qu'une ligne)
# En dev, le backend journalise la valeur au demarrage.
# VIDE = DEGRADE ASSUME : la garde retombe sur la seule presence du cookie. Une valeur
# NON VIDE mais illisible est signalee par un console.warn au premier passage.
AUTH_JWT_PUBLIC_KEY=
