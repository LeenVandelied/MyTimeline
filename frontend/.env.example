# =============================================================
# EXEMPLE de configuration frontend (Next.js).
# Copier vers .env.local et renseigner les valeurs. NE PAS committer .env.local.
# Les variables NEXT_PUBLIC_* sont exposees au navigateur : aucun secret ici.
# =============================================================

# URL de base de l'API backend (ex : http://localhost:8080)
NEXT_PUBLIC_API_URL=

# Origine canonique des redirections emises par middleware.ts (#322).
# NON publique : lue au runtime serveur, jamais envoyee au navigateur.
# Liste separee par des virgules, la PREMIERE entree est le canonique.
# Ex : https://mytimeline.example  /  localhost:3000  /  app.example.com:8443
# VIDE = degrade assume (aucune reecriture). Cf. docs/adr/ADR-004.
APP_CANONICAL_HOST=

# URL du JWKS du backend (#358) : le middleware y DECOUVRE la cle PUBLIQUE de verification
# de signature du cookie `jwt`, au lieu de la lire dans une variable recopiee a la main.
# Remplace AUTH_JWT_PUBLIC_KEY, SUPPRIMEE.
# NON publique au sens Next (lue au runtime serveur, jamais envoyee au navigateur).
#
# ⚠ Doit etre joignable DEPUIS LE SERVEUR Next, et non depuis le navigateur : ce n'est pas
# la meme adresse que NEXT_PUBLIC_API_URL (en docker-compose, `http://backend:8080/...` ;
# `localhost:8080` depuis le conteneur frontend designerait le frontend lui-meme).
#   Ex. local hors Docker : http://localhost:8080/.well-known/jwks.json
#   Ex. prod              : https://api.exemple/.well-known/jwks.json
# VIDE = DEGRADE ASSUME : la garde retombe sur la seule presence du cookie. Un JWKS
# configure mais injoignable est signale par un console.warn one-shot en production.
AUTH_JWKS_URL=
