{
 "packs": {
  "event": {
   "kind": "domain",
   "keywords": [
    "event",
    "événement",
    "evenement",
    "recurrence",
    "récurrence",
    "timeline"
   ],
   "routes": [
    "/api/events",
    "events/evt-desktop",
    "events/evt-mobile"
   ],
   "entities": [
    "EventEntity"
   ],
   "paths": [
    "frontend:components/events/",
    "frontend:components/timeline/"
   ],
   "name_globs": [
    "**/Event*",
    "**/*event*",
    "**/EventEntity*",
    "**/*recurrence*"
   ]
  },
  "user": {
   "kind": "domain",
   "keywords": [
    "user",
    "utilisateur",
    "auth",
    "login",
    "register",
    "password",
    "mot de passe",
    "avatar",
    "email",
    "theme",
    "preference"
   ],
   "routes": [
    "/api/auth",
    "/api/me",
    "/api/test-support",
    "me/avatar",
    "me/export"
   ],
   "entities": [
    "UserEntity",
    "PasswordResetTokenEntity"
   ],
   "paths": [
    "frontend:components/settings/"
   ],
   "name_globs": [
    "**/User*",
    "**/*user*",
    "**/UserEntity*",
    "**/PasswordReset*",
    "**/PasswordResetTokenEntity*",
    "**/*password*",
    "**/*auth*",
    "**/*role*",
    "**/*theme*",
    "**/*preference*",
    "**/*settings*"
   ]
  },
  "product": {
   "kind": "domain",
   "keywords": [
    "product",
    "produit",
    "products"
   ],
   "routes": [
    "users/user-1/products",
    "users/user-1/products/p2"
   ],
   "entities": [
    "ProductEntity"
   ],
   "paths": [
    "frontend:components/dashboard/"
   ],
   "name_globs": [
    "**/Product*",
    "**/*product*",
    "**/ProductEntity*"
   ]
  },
  "session": {
   "kind": "domain",
   "keywords": [
    "session",
    "jwt",
    "jwks",
    "token",
    "jeton"
   ],
   "routes": [
    "/api/sessions"
   ],
   "entities": [
    "SessionEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Session*",
    "**/*session*",
    "**/SessionEntity*"
   ]
  },
  "category": {
   "kind": "domain",
   "keywords": [
    "category",
    "catégorie",
    "categorie",
    "categories"
   ],
   "routes": [
    "/api/categories",
    "api/categories"
   ],
   "entities": [
    "CategoryEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Category*",
    "**/*category*",
    "**/CategoryEntity*"
   ]
  },
  "export": {
   "kind": "domain",
   "keywords": [
    "export",
    "exportjob",
    "zip",
    "csv",
    "markdown",
    "téléchargement"
   ],
   "routes": [
    "/api/export"
   ],
   "entities": [
    "ExportJobEntity"
   ],
   "paths": [
    "backend:src/main/java/com/matimeline/eventmanager/infrastructure/adapters/export/"
   ],
   "name_globs": [
    "**/ExportJob*",
    "**/ExportJobEntity*"
   ]
  },
  "backend-core": {
   "kind": "technical",
   "layers": [
    "backend/infrastructure",
    "backend/db",
    "backend/",
    "backend/support",
    "backend/architecture",
    "backend/build"
   ],
   "paths": [
    "backend:src/main/java/com/matimeline/eventmanager/infrastructure/config/"
   ]
  },
  "frontend-core": {
   "kind": "technical",
   "layers": [
    "frontend/components",
    "frontend/lib",
    "frontend/hooks",
    "frontend/services",
    "frontend/__tests__",
    "frontend/styles",
    "frontend/contexts",
    "frontend/i18n",
    "frontend/utils"
   ],
   "paths": [
    "frontend:__tests__/",
    "frontend:styles/",
    "frontend:components/landing/"
   ]
  },
  "frontend-app": {
   "kind": "technical",
   "layers": [
    "frontend-app/[locale]",
    "frontend-app/(root)"
   ],
   "paths": [
    "frontend-app:[locale]/"
   ]
  },
  "authorization": {
   "kind": "transversal",
   "motif": "authorization",
   "crosses": [
    "user",
    "session",
    "export"
   ]
  },
  "integrations": {
   "kind": "transversal",
   "motif": "integrations",
   "crosses": [
    "user",
    "event",
    "export",
    "session",
    "product",
    "category"
   ]
  },
  "batch": {
   "kind": "transversal",
   "motif": "batch",
   "crosses": [
    "user",
    "export"
   ]
  }
 },
 "rules": {
  "domain": "un mot-clé, une route, une entité ou un chemin cité dans la demande ou dans le diff",
  "transversal": "chargé si un fichier du périmètre a une densité de motif ≥ 3, ou si le domaine chargé est dans crosses et la demande touche la préoccupation",
  "technical": "chargé par couche touchée (backend, frontend, base)"
 }
}