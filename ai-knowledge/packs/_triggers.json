  "backend-socle": {
   "kind": "technical",
   "layers": [
    "mytimeline/infrastructure",
    "mytimeline/db",
    "mytimeline/",
    "mytimeline/domain",
    "mytimeline/support",
    "mytimeline/application",
    "mytimeline/architecture",
    "mytimeline/build"
   ],
   "paths": [
    "mytimeline:backend/src/main/java/com/matimeline/eventmanager/infrastructure/config/"
   ]
  },
  "authorization": {
   "kind": "transversal",
   "motif": "authorization",
   "crosses": [
    "user",
    "session",
    "export"
   ]
  },
  "integrations": {
   "kind": "transversal",
   "motif": "integrations",
   "crosses": [
    "user",
    "export",
    "event",
    "session",
    "product",
    "category"
   ]
  }
 },
 "rules": {
  "domain": "un mot-clé, une route, une entité ou un chemin cité dans la demande ou dans le diff",
  "transversal": "chargé si un fichier du périmètre a une densité de motif ≥ 3, ou si le domaine chargé est dans crosses et la demande touche la préoccupation",
  "technical": "chargé par couche touchée (backend, frontend, base)"
 }
}