{
 "packs": {
  "event": {
   "kind": "domain",
   "keywords": [
    "event",
    "événement",
    "evenement",
    "recurrence",
    "récurrence",
    "timeline",
    "passwordresettoken"
   ],
   "routes": [
    "/api/events"
   ],
   "entities": [
    "EventEntity",
    "PasswordResetTokenEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Event*",
    "**/*event*"
   ]
  },
  "user": {
   "kind": "domain",
   "keywords": [
    "user",
    "utilisateur",
    "auth",
    "login",
    "register",
    "password",
    "mot de passe",
    "avatar",
    "email",
    "theme",
    "preference"
   ],
   "routes": [
    "/api/auth",
    "/api/me",
    "/api/test-support",
    "api/me",
    "api/me/avatar",
    "api/me/export",
    "me",
    "me/avatar",
    "me/export"
   ],
   "entities": [
    "UserEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/User*",
    "**/*user*",
    "**/PasswordResetToken*",
    "**/*auth*"
   ]
  },
  "product": {
   "kind": "domain",
   "keywords": [
    "product",
    "produit",
    "products"
   ],
   "routes": [],
   "entities": [
    "ProductEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Product*",
    "**/*product*"
   ]
  },
  "session": {
   "kind": "domain",
   "keywords": [
    "session",
    "jwt",
    "jwks",
    "token",
    "jeton"
   ],
   "routes": [
    "/api/sessions"
   ],
   "entities": [
    "SessionEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Session*",
    "**/*session*"
   ]
  },
  "category": {
   "kind": "domain",
   "keywords": [
    "category",
    "catégorie",
    "categorie",
    "categories"
   ],
   "routes": [
    "/api/categories"
   ],
   "entities": [
    "CategoryEntity"
   ],
   "paths": [],
   "name_globs": [
    "**/Category*",
    "**/*category*"
   ]
  },
  "export": {
   "kind": "domain",
   "keywords": [
    "export",
    "exportjob",
    "zip",
    "csv",
    "markdown",
    "téléchargement"
   ],
   "routes": [
    "/api/export"
   ],
   "entities": [
    "ExportJobEntity"
   ],
   "paths": [
    "backend:src/main/java/com/matimeline/eventmanager/infrastructure/adapters/export/"
   ],
   "name_globs": [
    "**/ExportJob*"
   ]
  },
  "backend-core": {
   "kind": "technical",
   "layers": [
    "backend/infrastructure",
    "backend/architecture",
    "backend/(root)",
    "backend/com",
    "backend/build",
    "backend/support",
    "backend/application"
   ],
   "paths": [
    "backend:src/main/java/com/matimeline/eventmanager/infrastructure/config/"
   ]
  },
  "frontend-core": {
   "kind": "technical",
   "layers": [
    "frontend/components/components",
    "frontend/hooks/hooks",
    "frontend/services/services",
    "frontend/__tests__/__tests__",
    "frontend/styles/styles",
    "frontend/types/types",
    "frontend/contexts/contexts",
    "frontend/utils/utils"
   ],
   "paths": [
    "frontend:components/dashboard/",
    "frontend:components/events/",
    "frontend:components/landing/",
    "frontend:components/products/",
    "frontend:components/settings/",
    "frontend:components/shared/",
    "frontend:components/timeline/",
    "frontend:components/ui/",
    "frontend:styles/__tests__/"
   ]
  },
  "frontend-app": {
   "kind": "technical",
   "layers": [
    "frontend-app/[locale]",
    "frontend-app/(root)"
   ],
   "paths": [
    "frontend-app:[locale]/(app)/"
   ]
  },
  "authorization": {
   "kind": "transversal",
   "motif": "authorization",
   "crosses": [
    "user",
    "session",
    "export"
   ]
  },
  "integrations": {
   "kind": "transversal",
   "motif": "integrations",
   "crosses": [
    "user",
    "event",
    "export",
    "session",
    "product",
    "category"
   ]
  },
  "batch": {
   "kind": "transversal",
   "motif": "batch",
   "crosses": [
    "user",
    "export"
   ]
  },
  "lib-socle": {
   "kind": "technical",
   "layers": [
    "frontend/lib/lib"
   ],
   "paths": []
  },
  "migrations": {
   "kind": "technical",
   "layers": [
    "backend/db"
   ],
   "paths": [
    "backend:src/main/resources/db/"
   ]
  }
 },
 "rules": {
  "domain": "un mot-clé, une route, une entité ou un chemin cité dans la demande ou dans le diff",
  "transversal": "chargé si un fichier du périmètre a une densité de motif ≥ 3, ou si le domaine chargé est dans crosses et la demande touche la préoccupation",
  "technical": "chargé par couche touchée (backend, frontend, base)"
 }
}