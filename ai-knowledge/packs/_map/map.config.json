{
 "project": "mytimeline",
 "repos": [
  {
   "name": "backend",
   "root": "../../../backend",
   "language": "java",
   "include": [
    "src/main/java/**/*.java",
    "src/test/java/**/*.java",
    "src/main/resources/db/**/*.sql"
   ],
   "exclude": [
    "**/.env*",
    "**/application*.properties",
    "**/application*.y*ml",
    "**/*.pem",
    "**/*secret*"
   ]
  },
  {
   "name": "frontend",
   "root": "../../../frontend/src",
   "language": "typescript",
   "include": [
    "**/*.ts",
    "**/*.tsx"
   ],
   "exclude": [
    "**/.env*",
    "**/application*.properties",
    "**/application*.y*ml",
    "**/*.pem",
    "**/*secret*"
   ]
  },
  {
   "name": "frontend-app",
   "root": "../../../frontend/app",
   "language": "typescript",
   "include": [
    "**/*.ts",
    "**/*.tsx"
   ],
   "exclude": [
    "**/.env*",
    "**/application*.properties",
    "**/application*.y*ml",
    "**/*.pem",
    "**/*secret*"
   ]
  }
 ],
 "seeds": {
  "entities": true,
  "routed_folders": true,
  "extra": [
   "Event",
   "Category",
   "Product",
   "Session",
   "ExportJob",
   "PasswordReset",
   "User"
  ]
 },
 "edges": {
  "source": "regex"
 },
 "tech_folders": [
  "__tests__",
  "components",
  "contexts",
  "hooks",
  "styles",
  "types"
 ],
 "thresholds": {
  "min_seed_files": 6,
  "merge_ratio": 0.9,
  "max_merge_target": 40,
  "pack_min_kb": 15,
  "replay_agent_new_leftover": 10
 },
 "motifs_file": "motifs.json",
 "aliases_file": "aliases.json",
 "packs_dir": ".."
}
