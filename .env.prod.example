# =============================================================
# Gabarit du fichier /opt/matimeline/.env de PRODUCTION (ADR-009, #370).
#
#   NE JAMAIS COMMITTER LE FICHIER RENSEIGNÉ. Le dépôt est PUBLIC : un secret
#   qui y atterrit est compromis définitivement, la purge d'historique n'y
#   change rien.
#
# Sur l'hôte :   sudo install -m 600 -o root -g root .env.prod.example /opt/matimeline/.env
#                puis renseigner les valeurs.
#
# ⚠ NE JAMAIS laisser une clé déclarée VIDE ici. Une ligne `VAR=` exportée écrase
#   le défaut Spring au lieu de le laisser s'appliquer, et les garde-fous #253/#323
#   ne voient plus la variable comme absente (cf. application-dev.properties:51).
#   Une variable qu'on ne veut pas : la SUPPRIMER, pas la vider.
# =============================================================

# --- Registry et version déployée -------------------------------------------
GHCR_OWNER=LeenVandelied
# IMAGE_TAG est écrit par le workflow deploy.yml dans .env.tag — ne pas le poser ici.

# --- Origine publique --------------------------------------------------------
# Sert à CORS_ALLOWED_ORIGINS, APP_CANONICAL_HOST et au lien de reset.
# Forme AVEC schéma exigée (#322) : un hôte nu laisse passer un x-forwarded-proto menteur.
PUBLIC_ORIGIN=https://matimeline.com

# --- Base de données ---------------------------------------------------------
POSTGRES_DB=eventmanager
DB_USERNAME=eventuser
DB_PASSWORD=REMPLACER_par_un_secret_genere

# --- Secrets applicatifs (fail-fast #323 : boot refusé si absents) -----------
# Clé privée RS256 PKCS#8 Base64, >= 2048 bits :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   openssl pkcs8 -topk8 -nocrypt -in jwt.pem -outform DER | base64 | tr -d '\n'
# ⚠ `tr -d '\n'` OBLIGATOIRE : le base64 GNU replie à 76 colonnes et un fichier .env
#   n'accepte pas de valeur multi-lignes — la clé arriverait TRONQUÉE. Le base64 de
#   macOS ne replie pas, l'écart ne se voit donc pas depuis un poste de dev macOS.
JWT_PRIVATE_KEY=REMPLACER
# openssl rand -base64 48
EXPORT_TOKEN_SECRET=REMPLACER

# --- Email transactionnel ----------------------------------------------------
# Sans clé valide, l'envoi est un NO-OP silencieux (#365) : la réinitialisation
# de mot de passe cesse de fonctionner sans qu'aucune erreur ne soit levée.
BREVO_API_KEY=REMPLACER
# Expéditeur. Le défaut du CODE est `no-reply@mytimeline.app`, domaine NON détenu :
# sans ces deux lignes, Brevo refuse l'envoi et le reset de mot de passe casse en
# silence. L'adresse doit être sur un domaine AUTHENTIFIÉ dans Brevo (DKIM/DMARC),
# la seule détention du domaine ne suffit pas.
BREVO_SENDER_EMAIL=no-reply@matimeline.com
BREVO_SENDER_NAME=Ma Timeline

# --- TLS ---------------------------------------------------------------------
# Adresse de contact Let's Encrypt (avis d'expiration). Caddy REFUSE de démarrer
# si elle est absente — vérifié.
ACME_EMAIL=REMPLACER

# --- COOKIE_DOMAIN : VOLONTAIREMENT ABSENTE ---------------------------------
# Topologie mono-domaine (ADR-009 §3) => cookie host-only, ce qui est correct.
# Ne l'ajouter QUE si front et API passent un jour sur des sous-domaines distincts,
# et alors avec l'eTLD+1 (`matimeline.com`), jamais un sous-domaine.
