# =============================================================
# EXEMPLE de configuration — documente TOUTES les variables d'env attendues.
# Copier les valeurs réelles dans l'environnement (shell, .env, secret manager),
# JAMAIS dans un fichier committé. Ce fichier ne contient AUCUNE vraie valeur.
# =============================================================

# --- Profil Spring ---
# Profil actif : dev (defaut) | prod
# Si absent, fallback SILENCIEUX vers 'dev' (confort dev). EN PRODUCTION, poser
# explicitement SPRING_PROFILES_ACTIVE=prod.
SPRING_PROFILES_ACTIVE=

# --- Marqueur d'environnement (garde-fou #111) ---
# Sert UNIQUEMENT au garde-fou fail-fast ProfileSafetyGuard : si ce marqueur vaut
# 'production' (ou 'prod') ALORS que le profil Spring actif est 'dev', le boot est
# REFUSE (IllegalStateException) pour empecher le fallback dev silencieux en prod.
# Valeurs : production | prod (declenchent le garde) ; staging/autre/vide = ignore.
# En PROD : poser ENVIRONMENT=production EN PLUS de SPRING_PROFILES_ACTIVE=prod.
# Alternative acceptee : APP_ENV (meme semantique).
ENVIRONMENT=

# --- Base de données PostgreSQL ---
# URL JDBC complete (default dev : jdbc:postgresql://localhost:5432/eventmanager)
DB_URL=
# Utilisateur DB (default dev : eventuser)
DB_USERNAME=
# Mot de passe DB — OBLIGATOIRE en prod, sinon le boot echoue
DB_PASSWORD=

# --- Securite JWT ---
# Cle secrete de signature des JWT (128 hex recommandes).
# OBLIGATOIRE. Generer : openssl rand -hex 64
# Toute rotation invalide TOUS les tokens existants (deconnexion globale).
JWT_SECRET=

# --- Email Brevo / mot de passe oublie (#49) ---
# Cle API Brevo (POST https://api.brevo.com/v3/smtp/email).
# OBLIGATOIRE en PROD pour que les emails de reinitialisation partent reellement.
# Absente (dev/test) : BrevoEmailService passe en no-op (warning), le flux ne casse pas.
# JAMAIS committer la vraie valeur.
BREVO_API_KEY=
# Expediteur affiche dans l'email (defaults : no-reply@mytimeline.app / MyTimeline)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Base de l'URL de reinitialisation cote front (#53). Le token est ajoute en ?token=...
# Default dev : http://localhost:3000/reset-password
RESET_URL_BASE=
# Duree de validite du token de reinitialisation en minutes (cadrage S8 : 15)
PASSWORD_RESET_TOKEN_VALIDITY_MINUTES=
